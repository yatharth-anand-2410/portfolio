---
import data from '../../data/lab/qape.json';
---
<div class="lab-qape">
<div class="qape" id="qape-root">
  <script type="application/json" id="qape-data" set:html={JSON.stringify(data)} />

  <div class="controls">
    <label>
      <span class="label">Target model</span>
      <select id="q-model">
        {Object.entries(data.models).map(([k, v]) => <option value={k}>{v as string}</option>)}
      </select>
    </label>
    <label>
      <span class="label">Task</span>
      <select id="q-task">
        {Object.entries(data.tasks).map(([k, v]) => <option value={k}>{v as string}</option>)}
      </select>
    </label>
  </div>

  <section aria-labelledby="q-scores-h">
    <h3 id="q-scores-h">Held-out test score, Q4</h3>
    <div class="bars" id="q-bars"></div>
    <p class="delta" id="q-delta" aria-live="polite"></p>
    <p class="note">Only Q4 runs are shown here. The FP16 runs of the optimizer saved no usable test scores (see the matrix below for FP16 results).</p>
  </section>

  <section aria-labelledby="q-prompts-h">
    <div class="row-head">
      <h3 id="q-prompts-h">Prompts</h3>
      <label class="check"><input type="checkbox" id="q-diff" checked /> Highlight differences</label>
    </div>
    <div class="prompts">
      <figure><figcaption class="label">Baseline prompt</figcaption><pre id="q-base" tabindex="0"></pre></figure>
      <figure><figcaption class="label" id="q-evo-cap">Evolved prompt</figcaption><pre id="q-evo" tabindex="0"></pre></figure>
    </div>
    <p class="note">Word-level diff, computed in your browser. <del class="k">Struck</del> words were removed; <ins class="k">shaded</ins> words were added. <code>{'{input}'}</code> is where the test item is inserted.</p>
  </section>

  <section aria-labelledby="q-gen-h">
    <h3 id="q-gen-h">Fitness by generation</h3>
    <label class="range">
      <span class="label">Generation <output id="q-gen-out">3</output></span>
      <input type="range" id="q-gen" min="0" max="3" step="1" value="3" />
    </label>
    <svg id="q-chart" viewBox="0 0 320 140" role="img" aria-label="Best fitness per generation" preserveAspectRatio="xMidYMid meet"></svg>
    <p class="note" id="q-gen-note"></p>
  </section>

  <section aria-labelledby="q-tr-h">
    <h3 id="q-tr-h">Cross-precision transfer matrix</h3>
    <p class="note">Llama-3.2-3B, test score per cell. Rows: the precision the prompt is run on. Columns: where the prompt came from. Shading is scaled within each task. Bold is the best prompt in that row.</p>
    <div class="tbl-wrap">
      <table class="matrix" id="q-matrix">
        <thead><tr><th>Task</th><th>Run on</th><th>Baseline prompt</th><th>Evolved on Q4</th><th>Evolved on FP16</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>
</div>
</div>

<script>
  const data = JSON.parse(document.getElementById('qape-data')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const mSel = $('q-model') as HTMLSelectElement;
  const tSel = $('q-task') as HTMLSelectElement;
  const genIn = $('q-gen') as HTMLInputElement;
  const diffCk = $('q-diff') as HTMLInputElement;
  const svgNS = 'http://www.w3.org/2000/svg';
  const f = (n: number) => n.toFixed(2) + '%';

  function cell() {
    return data.cells.find((c: any) => c.model === mSel.value && c.task === tSel.value);
  }

  // Word-level LCS diff.
  function diff(a: string, b: string) {
    const A = a.split(/(\s+)/), B = b.split(/(\s+)/);
    const n = A.length, m = B.length;
    const L: Uint16Array[] = Array.from({ length: n + 1 }, () => new Uint16Array(m + 1));
    for (let i = n - 1; i >= 0; i--) for (let j = m - 1; j >= 0; j--)
      L[i][j] = A[i] === B[j] ? L[i + 1][j + 1] + 1 : Math.max(L[i + 1][j], L[i][j + 1]);
    const left: [string, boolean][] = [], right: [string, boolean][] = [];
    let i = 0, j = 0;
    while (i < n && j < m) {
      if (A[i] === B[j]) { left.push([A[i], false]); right.push([B[j], false]); i++; j++; }
      else if (L[i + 1][j] >= L[i][j + 1]) { left.push([A[i++], true]); }
      else { right.push([B[j++], true]); }
    }
    while (i < n) left.push([A[i++], true]);
    while (j < m) right.push([B[j++], true]);
    return { left, right };
  }
  function render(el: HTMLElement, parts: [string, boolean][], tag: 'del' | 'ins') {
    el.textContent = '';
    for (const [t, changed] of parts) {
      if (changed && t.trim()) { const e = document.createElement(tag); e.textContent = t; el.appendChild(e); }
      else el.appendChild(document.createTextNode(t));
    }
  }

  function bars(c: any) {
    const host = $('q-bars'); host.textContent = '';
    for (const [label, v, cls] of [['Baseline', c.baseline, 'base'], ['Evolved', c.evolved, 'evo']] as const) {
      const row = document.createElement('div'); row.className = 'bar-row ' + cls;
      row.innerHTML = '<span class="label"></span><div class="bar-track"><div class="bar-fill"></div></div><span class="bar-val"></span>';
      row.children[0].textContent = label;
      (row.querySelector('.bar-fill') as HTMLElement).style.width = Math.max(0, Math.min(100, v)) + '%';
      row.children[2].textContent = f(v);
      host.appendChild(row);
    }
    const d = c.evolved - c.baseline;
    $('q-delta').textContent = (d > 0 ? '+' : '') + d.toFixed(2) + ' points absolute' + (d === 0 ? ' (no change)' : '');
  }

  function prompts(c: any) {
    const { left, right } = diff(c.baselinePrompt, c.evolvedPrompt);
    render($('q-base'), left, 'del');
    render($('q-evo'), right, 'ins');
  }

  function chart(c: any, g: number) {
    const svg = $('q-chart'); svg.textContent = '';
    const W = 320, H = 140, pl = 34, pr = 12, pt = 12, pb = 28;
    const sc = c.history.map((h: any) => h.score);
    const max = Math.max(10, Math.ceil(Math.max(...sc) / 10) * 10);
    const x = (i: number) => pl + (i / (c.history.length - 1)) * (W - pl - pr);
    const y = (v: number) => pt + (1 - v / max) * (H - pt - pb);
    const mk = (n: string, a: Record<string, string | number>) => {
      const e = document.createElementNS(svgNS, n); for (const k in a) e.setAttribute(k, String(a[k])); svg.appendChild(e); return e;
    };
    for (const t of [0, max / 2, max]) {
      mk('line', { x1: pl, x2: W - pr, y1: y(t), y2: y(t), stroke: 'var(--rule)', 'stroke-width': 1 });
      const tx = mk('text', { x: pl - 6, y: y(t) + 3, 'text-anchor': 'end', 'font-size': 9, fill: 'var(--ink-soft)', 'font-family': 'var(--font-mono)' }); tx.textContent = String(t);
    }
    c.history.forEach((h: any, i: number) => {
      const tx = mk('text', { x: x(i), y: H - 10, 'text-anchor': 'middle', 'font-size': 9, fill: 'var(--ink-soft)', 'font-family': 'var(--font-mono)' }); tx.textContent = 'gen ' + h.g;
    });
    mk('polyline', { points: sc.map((v: number, i: number) => x(i) + ',' + y(v)).join(' '), fill: 'none', stroke: 'var(--ink-blue)', 'stroke-width': 2 });
    sc.forEach((v: number, i: number) => {
      mk('circle', { cx: x(i), cy: y(v), r: i === g ? 6 : 3.5, fill: i === g ? 'var(--accent)' : 'var(--paper)', stroke: i === g ? 'var(--accent)' : 'var(--ink-blue)', 'stroke-width': 2 });
    });
  }

  function gen(c: any) {
    const g = Number(genIn.value);
    $('q-gen-out').textContent = String(g);
    chart(c, g);
    const h = c.history[g];
    const { left, right } = diff(c.baselinePrompt, h.prompt);
    render($('q-base'), left, 'del');
    render($('q-evo'), right, 'ins');
    $('q-evo-cap').textContent = g === c.history.length - 1 ? 'Evolved prompt (final)' : 'Prompt at generation ' + g;
    $('q-gen-note').textContent = 'Generation ' + g + ': validation fitness ' + f(h.score) + '. The right-hand prompt above updates to the prompt held at this generation. Fitness is measured on the 40% validation split, so it differs from the held-out test score.';
  }

  function matrix() {
    const body = document.querySelector('#q-matrix tbody')!; body.textContent = '';
    const byTask: Record<string, any[]> = {};
    data.transfer.forEach((r: any) => (byTask[r.task] ||= []).push(r));
    for (const t of Object.keys(byTask)) {
      const rows = byTask[t];
      const vals = rows.flatMap((r) => [r.baseline, r.q4, r.fp16]);
      const lo = Math.min(...vals), hi = Math.max(...vals);
      rows.forEach((r, i) => {
        const tr = document.createElement('tr');
        const th = document.createElement('td'); th.textContent = i === 0 ? data.tasks[t] : ''; tr.appendChild(th);
        const pr = document.createElement('td'); pr.textContent = r.precision; tr.appendChild(pr);
        const best = Math.max(r.baseline, r.q4, r.fp16);
        for (const v of [r.baseline, r.q4, r.fp16]) {
          const td = document.createElement('td'); td.className = 'v' + (v === best ? ' best' : '');
          const k = hi === lo ? 0 : (v - lo) / (hi - lo);
          td.style.background = `color-mix(in srgb, var(--accent) ${Math.round(8 + k * 40)}%, transparent)`;
          td.textContent = f(v); tr.appendChild(td);
        }
        body.appendChild(tr);
      });
    }
  }

  function update() {
    const c = cell();
    bars(c);
    genIn.max = String(c.history.length - 1);
    genIn.value = String(c.history.length - 1);
    prompts(c);
    gen(c);
  }
  genIn.addEventListener('input', () => gen(cell()));
  mSel.addEventListener('change', update);
  tSel.addEventListener('change', update);
  diffCk.addEventListener('change', () => {
    $('q-base').classList.toggle('off', !diffCk.checked);
    $('q-evo').classList.toggle('off', !diffCk.checked);
  });
  matrix();
  update();
</script>

<style is:global>
.lab-qape {
  .qape { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.75rem; }
  .qape h3 { margin: 0 0 0.9rem; }
  .controls { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .controls label { display: grid; gap: 0.35rem; min-width: min(100%, 15rem); }
  select {
    font: inherit; font-size: 1rem; color: var(--ink); background: var(--paper-2);
    border: 1px solid var(--rule); border-radius: 2px; padding: 0.55rem 0.7rem; min-height: 44px; width: 100%;
  }
  .bars { display: grid; gap: 0.7rem; }
  .bar-row { display: grid; grid-template-columns: 5.5rem 1fr 4rem; align-items: center; gap: 0.75rem; }
  .bar-track { height: 1.5rem; background: var(--paper-2); border: 1px solid var(--rule); }
  .bar-fill { height: 100%; background: var(--ink-blue); transition: width 0.4s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .bar-row.evo .bar-fill { background: var(--accent); }
  .bar-val { font-family: var(--font-mono); font-size: 0.85rem; text-align: right; }
  .delta { font-family: var(--font-mono); font-size: 0.85rem; margin: 0.9rem 0 0.4rem; }
  .note { font-size: 0.88rem; color: var(--ink-soft); margin: 0.6rem 0 0; }
  .row-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
  .check { font-size: 0.9rem; display: flex; gap: 0.5rem; align-items: center; min-height: 32px; }
  .prompts { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  @media (min-width: 52rem) { .prompts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  figure { margin: 0; }
  figcaption { margin-bottom: 0.4rem; }
  pre {
    font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.65; margin: 0; white-space: pre-wrap; overflow-wrap: anywhere;
    padding: 1rem; border: 1px solid var(--rule); border-left: 3px solid var(--ink-blue); border-radius: 2px; min-height: 8rem;
    max-height: 26rem; overflow: auto;
  }
  #q-evo { border-left-color: var(--accent); }
  .qape ins, .qape del { text-decoration: none; }
  .qape ins { background: color-mix(in srgb, var(--accent) 24%, transparent); }
  .qape del { text-decoration: line-through; background: color-mix(in srgb, var(--ink-soft) 18%, transparent); }
  .qape .off ins, .qape .off del { background: none; text-decoration: none; }
  .range { display: grid; gap: 0.4rem; max-width: 26rem; }
  input[type='range'] { width: 100%; min-height: 44px; accent-color: var(--accent); }
  #q-chart { width: 100%; max-width: 36rem; height: auto; display: block; margin-top: 0.5rem; }
  .tbl-wrap { overflow-x: auto; }
  .matrix { border-collapse: collapse; width: 100%; font-size: 0.9rem; min-width: 30rem; }
  .matrix th, .matrix td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--rule); text-align: left; }
  .matrix th { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); font-weight: 400; }
  .matrix td.v { font-family: var(--font-mono); text-align: center; }
  .matrix td.best { font-weight: 700; }
  @media (prefers-reduced-motion: reduce) { .bar-fill { transition: none; } }
}
</style>
