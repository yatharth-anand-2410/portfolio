---
import data from '../data/leadforge-replay.json';
---
<div class="lab-lf">
<div class="lf" id="lf-root">
  <script type="application/json" id="lf-data" set:html={JSON.stringify(data)} />

  <div class="lf-controls">
    <label>
      <span class="label">Recorded run</span>
      <select id="lf-run">
        {data.runs.map((r: any, i: number) => <option value={i}>{r.title}</option>)}
      </select>
    </label>
    <label>
      <span class="label">Replay speed</span>
      <select id="lf-speed">
        <option value="10">10x</option>
        <option value="30" selected>30x</option>
        <option value="60">60x</option>
      </select>
    </label>
  </div>

  <section aria-labelledby="lf-brief-h">
    <h3 id="lf-brief-h">The brief given to the agent</h3>
    <p class="lf-brief" id="lf-brief"></p>
  </section>

  <section aria-labelledby="lf-log-h">
    <h3 id="lf-log-h">Progress log</h3>
    <div class="lf-transport">
      <button type="button" id="lf-play" class="lf-btn" aria-pressed="false">Play</button>
      <button type="button" id="lf-reset" class="lf-btn">Restart</button>
      <label class="lf-range">
        <span class="label">Step <output id="lf-step-out">0</output> of <span id="lf-step-max">0</span></span>
        <input type="range" id="lf-step" min="0" max="0" step="1" value="0" />
      </label>
    </div>
    <p class="lf-clock mono" id="lf-clock" aria-live="polite"></p>
    <div class="lf-meter" aria-hidden="true"><div class="lf-meter-fill" id="lf-meter"></div></div>
    <ol class="lf-log" id="lf-logs" aria-label="Recorded progress events"></ol>
  </section>

  <section aria-labelledby="lf-leads-h">
    <h3 id="lf-leads-h">Shortlist <span class="lf-count" id="lf-count"></span></h3>
    <div class="lf-tbl-wrap" tabindex="0" role="region" aria-label="Shortlist table, scrolls sideways on narrow screens">
      <table class="lf-table">
        <thead><tr><th>Business</th><th>Locality</th><th>Website</th><th>Score</th><th>Contacts (masked)</th><th>Checks</th></tr></thead>
        <tbody id="lf-rows"></tbody>
      </table>
    </div>
    <p class="lf-note" id="lf-empty">No leads saved yet. Press Play or drag the slider.</p>
  </section>
</div>
</div>

<script>
  type Step = { t: number; stage: string; message: string; counts: { leads: number }; leadIndex?: number };
  const data = JSON.parse(document.getElementById('lf-data')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const runSel = $('lf-run') as HTMLSelectElement;
  const speedSel = $('lf-speed') as HTMLSelectElement;
  const slider = $('lf-step') as HTMLInputElement;
  const playBtn = $('lf-play') as HTMLButtonElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let run: any = data.runs[0];
  let cur = 0;
  let timer: number | undefined;

  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  const el = (tag: string, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  };

  function stop() {
    if (timer !== undefined) clearTimeout(timer);
    timer = undefined;
    playBtn.textContent = cur >= run.steps.length - 1 ? 'Replay' : 'Play';
    playBtn.setAttribute('aria-pressed', 'false');
  }

  function render() {
    const steps: Step[] = run.steps;
    const s = steps[cur];
    slider.value = String(cur);
    $('lf-step-out').textContent = String(cur + 1);
    $('lf-clock').textContent = `Recorded clock ${fmt(s.t)} of ${fmt(steps[steps.length - 1].t)} · stage: ${s.stage} · ${s.counts.leads} of ${run.icp.targetLeads} leads saved`;
    ($('lf-meter') as HTMLElement).style.width = `${Math.min(100, (s.counts.leads / run.icp.targetLeads) * 100)}%`;

    const ol = $('lf-logs');
    ol.replaceChildren();
    steps.slice(0, cur + 1).forEach((st, i) => {
      const li = el('li', i === cur ? 'now' : '');
      li.append(el('span', 'lf-t mono', fmt(st.t)), el('span', 'lf-msg', st.message));
      ol.append(li);
    });
    ol.scrollTop = ol.scrollHeight;

    const shown = new Set<number>();
    steps.slice(0, cur + 1).forEach((st) => { if (st.leadIndex !== undefined) shown.add(st.leadIndex); });
    const tb = $('lf-rows');
    tb.replaceChildren();
    [...shown].sort((a, b) => a - b).forEach((idx) => {
      const l = run.leads[idx];
      const tr = el('tr');
      const name = el('td', 'nm'); name.append(el('strong', '', l.name)); if (l.category) name.append(el('span', 'lf-sub', l.category));
      const site = el('td', 'mono lf-dom', l.domain || 'none');
      const sc = el('td', 'mono', String(l.score));
      const ct = el('td', 'ct');
      ct.append(el('span', 'mono', l.email || 'no email found'));
      ct.append(el('span', 'mono', l.phone || 'no phone found'));
      if (l.role) ct.append(el('span', 'lf-sub', l.role));
      const ck = el('td', 'ck');
      l.badges.forEach((b: any) => ck.append(el('span', 'lf-badge ' + (b.ok ? 'ok' : 'no'), (b.ok ? 'Yes: ' : 'No: ') + b.label)));
      tr.append(name, el('td', '', l.locality), site, sc, ct, ck);
      tb.append(tr);
    });
    $('lf-count').textContent = `(${shown.size} of ${run.icp.targetLeads} target)`;
    $('lf-empty').hidden = shown.size > 0;
  }

  function schedule() {
    const steps: Step[] = run.steps;
    if (cur >= steps.length - 1) { stop(); return; }
    const gap = (steps[cur + 1].t - steps[cur].t) / Number(speedSel.value);
    const delay = Math.min(1500, Math.max(250, gap * 1000));
    timer = window.setTimeout(() => { cur += 1; render(); schedule(); }, delay);
  }

  function play() {
    if (cur >= run.steps.length - 1) cur = 0;
    render();
    playBtn.textContent = 'Pause';
    playBtn.setAttribute('aria-pressed', 'true');
    schedule();
  }

  function loadRun(i: number) {
    stop();
    run = data.runs[i];
    cur = 0;
    slider.max = String(run.steps.length - 1);
    $('lf-step-max').textContent = String(run.steps.length);
    $('lf-brief').textContent = `"${run.icp.brief}" with a target of ${run.icp.targetLeads} leads. Outcome: ${run.outcome}`;
    render();
  }

  playBtn.addEventListener('click', () => (timer === undefined ? play() : stop()));
  $('lf-reset').addEventListener('click', () => { stop(); cur = 0; render(); });
  slider.addEventListener('input', () => { stop(); cur = Number(slider.value); render(); });
  runSel.addEventListener('change', () => loadRun(Number(runSel.value)));
  speedSel.addEventListener('change', () => { if (timer !== undefined) { clearTimeout(timer); schedule(); } });
  if (reduce) $('lf-clock').dataset.reduced = 'true';
  loadRun(0);
</script>

<style is:global>
.lab-lf {
  .lf { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
  .lf h3 { margin: 0 0 0.9rem; }
  .lf-controls { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .lf-controls label { display: grid; gap: 0.35rem; min-width: min(100%, 15rem); }
  select {
    font: inherit; font-size: 1rem; color: var(--ink); background: var(--paper-2);
    border: 1px solid var(--rule); border-radius: 2px; padding: 0.55rem 0.7rem; min-height: 44px; width: 100%;
  }
  .lf-brief { margin: 0; max-width: var(--measure); color: var(--ink-soft); }
  .lf-transport { display: flex; flex-wrap: wrap; align-items: end; gap: 0.75rem 1rem; }
  .lf-btn {
    font: inherit; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.04em; text-transform: uppercase;
    min-height: 44px; min-width: 5.5rem; padding: 0 1rem; cursor: pointer;
    color: var(--paper); background: var(--ink); border: 1px solid var(--ink); border-radius: 2px;
  }
  .lf-btn:hover { background: var(--accent); border-color: var(--accent); }
  .lf-btn:focus-visible, input[type='range']:focus-visible, .lf-tbl-wrap:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #lf-reset { color: var(--ink); background: transparent; }
  .lf-range { display: grid; gap: 0.3rem; flex: 1 1 14rem; min-width: 0; }
  input[type='range'] { width: 100%; min-height: 44px; accent-color: var(--accent); }
  .lf-clock { font-size: 0.8rem; margin: 0.9rem 0 0.5rem; color: var(--ink-soft); overflow-wrap: anywhere; }
  .lf-meter { height: 0.6rem; background: var(--paper-2); border: 1px solid var(--rule); }
  .lf-meter-fill { height: 100%; width: 0; background: var(--accent); transition: width 0.3s ease; }
  .lf-log {
    list-style: none; margin: 0.9rem 0 0; padding: 0.4rem 0; max-height: 15rem; overflow: auto;
    border: 1px solid var(--rule); border-left: 3px solid var(--ink-blue); border-radius: 2px;
  }
  .lf-log li { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 0.6rem; padding: 0.3rem 0.8rem; font-size: 0.9rem; line-height: 1.45; }
  .lf-log li.now { background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .lf-t { font-size: 0.75rem; color: var(--ink-soft); padding-top: 0.15rem; }
  .lf-msg { overflow-wrap: anywhere; }
  .lf-count { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 400; color: var(--ink-soft); }
  .lf-tbl-wrap { overflow-x: auto; border: 1px solid var(--rule); max-width: 100%; }
  .lf-table { border-collapse: collapse; width: 100%; min-width: 52rem; font-size: 0.88rem; }
  .lf-table th, .lf-table td { padding: 0.65rem 0.75rem; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .lf-table th { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); font-weight: 400; }
  .lf-table td.ct, .lf-table td.nm { display: table-cell; }
  .lf-table td.ct .mono, .lf-table td.ck .lf-badge { display: block; }
  .lf-sub { display: block; font-size: 0.78rem; color: var(--ink-soft); }
  .lf-dom { font-size: 0.78rem; overflow-wrap: anywhere; }
  .lf-table .mono, .lf-clock, .lf-t, .lf-badge { font-size: 0.78rem; text-transform: none; letter-spacing: 0; }
  .lf-badge { font-family: var(--font-mono); font-size: 0.68rem; line-height: 1.5; margin-bottom: 0.2rem; }
  .lf-badge.ok { color: var(--ink-blue); }
  .lf-badge.no { color: var(--ink-soft); }
  .lf-note { font-size: 0.88rem; color: var(--ink-soft); margin: 0.8rem 0 0; }
  @media (prefers-reduced-motion: reduce) { .lf-meter-fill { transition: none; } }
}
</style>
