---
// Former side-note layout, now a single column: the note renders as a small muted line above the body.
---

<div class="notebook">
  <p class="margin"><slot name="note" /></p>
  <div class="main"><slot /></div>
</div>

<style>
  .margin { font-size: 0.88rem; color: var(--ink-soft); margin: 0 0 1.25rem; }
  .margin :global(br) { display: none; }
  .margin :global(br)::after { content: ' · '; }
</style>
