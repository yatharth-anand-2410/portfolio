---
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#projects', label: 'Projects' },
  { href: '/lab/', label: 'Lab' },
  { href: '/blog/', label: 'Writing' },
  { href: '/#about', label: 'About' },
];
---

<header class="site-header wrap">
  <a class="brand" href="/">Yatharth Anand</a>
  <nav aria-label="Primary">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <button id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
      <span class="t-light">Dark</span><span class="t-dark">Light</span>
    </button>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .site-header {
    display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap;
    gap: 0.5rem 1.5rem; padding-top: 1.75rem; padding-bottom: 1rem;
  }
  .brand { font-weight: 650; color: var(--ink); text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; font-size: 0.95rem; }
  nav a { color: var(--ink-soft); text-decoration: none; }
  nav a:hover { color: var(--ink); text-decoration: underline; }
  button {
    font: inherit; font-size: 0.95rem; color: var(--ink-soft); background: none; border: 0; padding: 0; cursor: pointer;
  }
  button:hover { color: var(--ink); text-decoration: underline; }
  :global(:root:not([data-theme='dark'])) .t-dark, :global(:root[data-theme='dark']) .t-light { display: none; }
</style>
