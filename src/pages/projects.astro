---
import BaseLayout from '../layouts/BaseLayout.astro';
import { research, contributions } from '../data/projects';
const gh = 'https://github.com/yatharth-anand-2410/';
---

<BaseLayout title="Projects" description="Research experiments on quantization and interpretability, and open source contributions.">
  <section class="wrap head">
    <p class="label reveal" style="--i:0">Research and open source</p>
    <h1 class="reveal" style="--i:1">Projects</h1>
    <p class="lede reveal" style="--i:2">
      Experiments where I take models apart to see how they work, plus fixes sent upstream.
      Products live under <a href="/work">Work</a>.
    </p>
  </section>

  <section class="wrap" aria-labelledby="research-h">
    <h2 id="research-h" class="label sect">Research</h2>
    <ul class="grid">
      {research.map((p, i) => (
        <li class="card reveal" style={`--i:${i + 3}`}>
          <h3><a href={gh + p.repo}>{p.title}</a></h3>
          <p>{p.summary}</p>
          <p class="label tags">{p.tags.join(' · ')}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap oss" aria-labelledby="oss-h">
    <h2 id="oss-h" class="label sect">Open source contributions</h2>
    <ul class="ledger">
      {contributions.map((c) => (
        <li>
          <p class="label">{c.repo} · {c.stars}</p>
          <h3><a href={c.url}>{c.title}</a></h3>
          <p>{c.note}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .head { padding-top: clamp(3rem, 8vw, 6rem); padding-bottom: 2rem; }
  .lede { max-width: 52ch; font-size: 1.2em; color: var(--ink-soft); }
  .sect { border-top: 1px solid var(--accent); padding-top: 0.7rem; margin: 2.5rem 0 1.5rem; font-weight: 400; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .card { background: var(--paper); padding: 1.6rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .card h3 { margin-bottom: 0.4rem; }
  .card h3 a { background-image: none; }
  .card:hover h3 a { color: var(--accent); }
  .card p { color: var(--ink-soft); font-size: 0.95em; margin: 0 0 0.6rem; }
  .tags { margin-top: auto !important; }
  .oss { padding-top: 1rem; }
  .ledger { list-style: none; margin: 0; padding: 0; }
  .ledger li { max-width: 62ch; }
  .ledger p { margin-bottom: 0.4rem; }
</style>
