---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marginalia from '../../components/Marginalia.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
const fmt = date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={title} description={description}>
  <article class="wrap">
    <header class="head">
      <p class="label reveal" style="--i:0"><a href="/blog/">← Notes</a></p>
      <h1 class="reveal" style="--i:1">{title}</h1>
    </header>

    <Marginalia>
      <Fragment slot="note">
        <time datetime={date.toISOString()}>{fmt}</time>
        <br /><br />
        {tags.map((t) => <span class="tag">#{t}</span>)}
      </Fragment>
      <div class="prose reveal" style="--i:2"><Content /></div>
    </Marginalia>
  </article>
</BaseLayout>

<style>
  .head { padding-top: clamp(2.5rem, 7vw, 5rem); padding-bottom: 2.5rem; }
  .head h1 { font-size: clamp(2.2rem, 5vw, 4rem); max-width: 20ch; margin-top: 1rem; }
  .tag { display: block; }

  .prose :global(h2) { margin-top: 2.2em; font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .prose :global(h3) { margin-top: 1.8em; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; margin: 0 0 1.1em; }
  .prose :global(li) { margin-bottom: 0.35em; }
  .prose :global(strong) { font-weight: 650; }
  .prose :global(code) {
    font-family: var(--font-mono); font-size: 0.82em; background: var(--paper-2);
    padding: 0.12em 0.4em; border-radius: 3px;
  }
  .prose :global(pre) {
    font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.6; overflow-x: auto;
    padding: 1.1rem 1.25rem; margin: 1.5em 0; border: 1px solid var(--rule); border-left: 3px solid var(--accent);
    border-radius: 2px;
  }
  .prose :global(pre code) { background: none; padding: 0; font-size: inherit; }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 1.5em 0; font-size: 0.9rem; width: 100%; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 0.6rem 0.9rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .prose :global(th) { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 2.5em 0; }
  .prose :global(blockquote) { margin: 1.5em 0; padding-left: 1.2rem; border-left: 3px solid var(--rule); color: var(--ink-soft); }
</style>
