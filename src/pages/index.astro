---
import BaseLayout from '../layouts/BaseLayout.astro';
import Specimen from '../components/Specimen.astro';
import Marginalia from '../components/Marginalia.astro';
import { getCollection } from 'astro:content';
import { MAILTO } from '../data/site';

const work = (await getCollection('work', (w) => !w.data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Home">
  <section class="hero wrap">
    <p class="label reveal" style="--i:0">Yatharth Anand — Senior ML Engineer · Bangalore</p>
    <h1 class="reveal" style="--i:1">
      I build AI systems that <em>hold up</em> in production.
    </h1>
    <p class="lede reveal" style="--i:2">
      Agentic workflows, retrieval, and the infrastructure underneath them. I audit LLM cost and
      reliability for teams running AI in production, and I take models apart to see how they work.
    </p>
    <p class="cta reveal" style="--i:3">
      <a href={MAILTO}>Request an audit</a>
      <a href="/services">What the audit covers</a>
      <a href="/work">See the work</a>
    </p>
  </section>

  <section class="wrap readings" aria-label="Selected measurements">
    <Specimen index={4} value="−50%" label="LLM inference cost" note="Prompt caching and context optimization across multi-channel agents." />
    <Specimen index={5} value="Millions" label="Records, multi-tenant" note="Python, PostgreSQL, AWS Lambda/ECS and vector search." />
    <Specimen index={6} value="1 of 5" label="Founding AI platform engineers" note="Core AI platform team at Zipteams since 2024." />
  </section>

  <section class="wrap selected" aria-labelledby="sel-h">
    <h2 id="sel-h" class="label sect">Selected work</h2>
    <ol class="ledger">
      {work.map((w, i) => (
        <li>
          <a class="row" href={`/work/${w.id}/`}>
            <span class="num label">{String(i + 1).padStart(2, '0')}</span>
            <span class="body"><span class="title">{w.data.title}</span><span class="desc">{w.data.summary}</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap marg">
    <Marginalia>
      <span slot="note">Fig. 1 — Open source<br />getzep/graphiti, ~32k ★</span>
      <h2>Fixing things in the open</h2>
      <p>
        I contribute bug fixes to agent-memory infrastructure. A merged change to Graphiti
        preserves node attributes when no entity type applies, shipped with regression tests
        that fail before the fix and pass after.
      </p>
      <p><a href="https://github.com/getzep/graphiti/pull/1764">Read the pull request</a></p>
    </Marginalia>
  </section>
</BaseLayout>

<style>
  .hero { padding-top: clamp(3rem, 9vw, 7rem); padding-bottom: clamp(2rem, 6vw, 4rem); }
  .hero h1 { max-width: 15ch; margin-block: 1rem 1.5rem; }
  .hero h1 em { color: var(--accent); font-style: italic; font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; }
  .lede { max-width: 46ch; font-size: 1.25em; color: var(--ink-soft); }
  .cta { display: flex; gap: 1.75rem; margin-top: 2rem; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .readings {
    display: grid; gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .marg { padding-top: clamp(2rem, 6vw, 5rem); }
  .selected { padding-top: clamp(1rem, 3vw, 2rem); }
  .sect { border-top: 1px solid var(--accent); padding-top: 0.7rem; margin-bottom: 1rem; font-weight: 400; }
  .ledger { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .ledger li { border-bottom: 1px solid var(--rule); }
  .row { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding-block: 1.5rem; background-image: none; }
  .num { color: var(--accent); }
  .body { display: flex; flex-direction: column; gap: 0.4rem; }
  .title { font-family: var(--font-display); font-size: clamp(1.3rem, 2.4vw, 1.8rem); line-height: 1.15; font-variation-settings: 'opsz' 72, 'SOFT' 50, 'WONK' 1; transition: color 0.2s; }
  .desc { color: var(--ink-soft); max-width: 62ch; font-size: 0.95em; }
  .row:hover .title { color: var(--accent); }
</style>
