---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { EMAIL, GITHUB_URL, LINKEDIN_URL } from '../data/site';
import { lab } from '../data/lab';
import { research, contributions } from '../data/projects';

const work = (await getCollection('work', (w) => !w.data.draft)).sort((a, b) => a.data.order - b.data.order);
const field = (await getCollection('field', (f) => !f.data.draft)).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const demos = [...lab].sort((a, b) => a.order - b.order);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' });
const gh = GITHUB_URL + '/';
const demoPage: Record<string, string> = { leadforge: '/demos/leadforge/' };
---

<BaseLayout title="Home">
  <article class="wrap home">
    <section class="intro">
      <p>
        Hi, I'm Yatharth. I'm a senior machine learning engineer in Bangalore. I build voice and WhatsApp
        AI agents that hold up on real calls, and the systems around them: retrieval, agentic workflows,
        memory and structured extraction.
      </p>
      <p>
        I'm one of the first five engineers on the core AI platform team at a B2B sales-AI startup, where
        I led the multi-channel agents and cut LLM inference cost by about 50%. On the side I take models
        apart to see how they work.
      </p>
      <p>I take on freelance work in three areas:</p>
      <ul>
        <li><strong>Voice and chat agents</strong> for calls, WhatsApp and chat, with memory, routing, qualification and callbacks.</li>
        <li><strong>Custom AI systems:</strong> retrieval, agentic workflows, extraction, and the evaluation that shows they work.</li>
        <li><strong>Cost and reliability audits</strong> for LLM features already in production (<a href="/audit/">how the audit works</a>).</li>
      </ul>
      <p>
        Email <a href={`mailto:${EMAIL}`}>{EMAIL}</a>, or find me on <a href={LINKEDIN_URL} rel="me">LinkedIn</a>{" "}and{" "}<a href={GITHUB_URL} rel="me">GitHub</a>.
      </p>
    </section>

    <section id="work">
      <h2>Production work</h2>
      <p class="note">Field notes from systems I run at work. Anonymized; numbers are ones I've shared publicly.</p>
      <ul class="list">
        {field.map((f) => (
          <li>
            <a href={`/field/${f.id}/`}>{f.data.title}</a>
            <span class="meta">{f.data.metric}</span>
            <p>{f.data.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="projects">
      <h2>Projects</h2>
      <ul class="list">
        {work.map((w) => (
          <li>
            <a href={`/work/${w.id}/`}>{w.data.title.split(':')[0]}</a>
            <span class="meta">
              {[
                w.data.video && 'video',
                w.data.liveUrl && <a href={w.data.liveUrl}>live</a>,
                demoPage[w.id] && <a href={demoPage[w.id]}>replay demo</a>,
                w.data.repoUrl && <a href={w.data.repoUrl}>code</a>,
              ].filter(Boolean).map((x, i) => <>{i > 0 && ' · '}{x}</>)}
            </span>
            <p>{w.data.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="lab">
      <h2>Lab</h2>
      <p class="note">Interactive demos built from my own experiments, using the saved results.</p>
      <ul class="list">
        {demos.map((d) => (
          <li>
            <a href={`/lab/${d.slug}/`}>{d.title}</a>
            <p>{d.summary}</p>
          </li>
        ))}
      </ul>
      <h3>Open source</h3>
      <ul class="plain">
        {contributions.map((c) => (
          <li><a href={c.url}>{c.repo}</a>: {c.title} (merged)</li>
        ))}
      </ul>
      <h3>Research repos</h3>
      <ul class="plain">
        {research.map((p) => (
          <li><a href={gh + p.repo}>{p.title}</a> <span class="meta">{p.tags.join(', ')}</span></li>
        ))}
      </ul>
    </section>

    <section id="writing">
      <h2>Writing</h2>
      <ul class="dated">
        {posts.map((p) => (
          <li><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time> <a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
        ))}
      </ul>
    </section>

    <section id="about">
      <h2>About</h2>
      <p>
        At work I architected multi-channel agents across email and WhatsApp (orchestration, memory,
        routing, workflow execution), sales-intelligence analytics (pitch evaluation, intent detection,
        structured extraction with human review), and the multi-tenant infrastructure underneath on
        Python, PostgreSQL, AWS and vector search, handling millions of records.
      </p>
      <p>
        Before that I was a data science intern at Farmart, forecasting commodity prices (5% MAPE on
        30-day predictions) and building sentiment pipelines for agricultural news. I studied computer
        science at IIIT Nagpur (2020 to 2024).
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .home { padding-top: 1rem; }
  section { margin-bottom: 2.5rem; }
  section + section { padding-top: 0.25rem; }
  h2 { margin-bottom: 0.6rem; }
  h3 { margin-top: 1.5rem; }
  .note { color: var(--ink-soft); font-size: 0.95rem; }
  .intro ul { padding-left: 1.2rem; }
  .intro li { margin-bottom: 0.35rem; }
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { margin-bottom: 1.1rem; }
  .list p { margin: 0.15rem 0 0; color: var(--ink-soft); font-size: 0.95rem; }
  .meta { color: var(--ink-soft); font-size: 0.85rem; margin-left: 0.4rem; }
  .meta a { color: var(--ink-soft); }
  .plain { padding-left: 1.2rem; }
  .plain li { margin-bottom: 0.35rem; }
  .dated { list-style: none; padding: 0; margin: 0; }
  .dated li { margin-bottom: 0.45rem; display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.75rem; }
  .dated time { color: var(--ink-soft); font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  @media (max-width: 30rem) { .dated li { grid-template-columns: 1fr; gap: 0; } }
</style>
